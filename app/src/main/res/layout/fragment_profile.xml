<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/profile_page_background">

    <TextView
        android:id="@+id/tvProfileTitle"
        android:layout_width="0dp"
        android:layout_height="@dimen/profile_header_height"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/profile_title_start_margin"
        android:paddingEnd="@dimen/profile_title_start_margin"
        android:text="@string/main_profile"
        android:textColor="@color/profile_text_primary"
        android:textSize="@dimen/profile_title_text_size"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollProfile"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvProfileTitle">

        <LinearLayout
            android:id="@+id/profileContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/profile_page_horizontal_margin"
            android:paddingTop="@dimen/profile_content_top_padding"
            android:paddingEnd="@dimen/profile_page_horizontal_margin"
            android:paddingBottom="@dimen/profile_content_bottom_padding">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUserInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/main_surface"
                app:cardCornerRadius="@dimen/profile_card_corner_radius"
                app:cardElevation="0dp"
                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/userContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/profile_card_content_padding">

                    <FrameLayout
                        android:id="@+id/avatarContainer"
                        android:layout_width="@dimen/profile_avatar_size"
                        android:layout_height="@dimen/profile_avatar_size"
                        android:clickable="true"
                        android:contentDescription="@string/profile_change_avatar"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:src="@drawable/icon_user_avatar"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.TeacherTalk.Avatar" />

                        <ProgressBar
                            android:id="@+id/progressAvatarUpload"
                            android:layout_width="@dimen/profile_avatar_upload_progress_size"
                            android:layout_height="@dimen/profile_avatar_upload_progress_size"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_profile_avatar_upload_progress"
                            android:contentDescription="@string/profile_avatar_uploading"
                            android:indeterminateTint="@color/main_primary"
                            android:padding="@dimen/profile_avatar_upload_progress_padding"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvNickname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/profile_avatar_content_gap"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/profile_text_primary"
                        android:textSize="@dimen/profile_nickname_text_size"
                        android:textStyle="bold"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintEnd_toStartOf="@id/btnEditProfile"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toEndOf="@id/avatarContainer"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="Alex" />

                    <FrameLayout
                        android:id="@+id/btnEditProfile"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/profile_edit_touch_height"
                        android:layout_marginStart="@dimen/profile_edit_start_gap"
                        android:clickable="true"
                        android:contentDescription="@string/profile_edit"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tvNickname"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:id="@+id/tvEditProfileLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/profile_edit_visual_height"
                            android:layout_gravity="top|center_horizontal"
                            android:background="@drawable/bg_profile_edit_button"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:minWidth="@dimen/profile_edit_min_width"
                            android:paddingStart="@dimen/profile_edit_horizontal_padding"
                            android:paddingEnd="@dimen/profile_edit_horizontal_padding"
                            android:text="@string/profile_edit"
                            android:textColor="@color/white"
                            android:textSize="@dimen/profile_edit_text_size" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvUserId"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/profile_avatar_content_gap"
                        android:layout_marginTop="@dimen/profile_meta_top_gap"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/profile_text_secondary"
                        android:textSize="@dimen/profile_meta_text_size"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/avatarContainer"
                        app:layout_constraintTop_toBottomOf="@id/tvNickname"
                        tools:text="ID: 10247" />

                    <TextView
                        android:id="@+id/tvUserBio"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/profile_avatar_content_gap"
                        android:layout_marginTop="@dimen/profile_meta_top_gap"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/profile_text_secondary"
                        android:textSize="@dimen/profile_meta_text_size"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/avatarContainer"
                        app:layout_constraintTop_toBottomOf="@id/tvUserId"
                        android:visibility="gone"
                        tools:text="这人很懒，什么都没留下。"
                        tools:visibility="visible" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUserStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/profile_card_gap"
                android:visibility="visible"
                app:cardBackgroundColor="@color/main_surface"
                app:cardCornerRadius="@dimen/profile_card_corner_radius"
                app:cardElevation="0dp"
                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/statsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/profile_stats_vertical_padding"
                    android:paddingBottom="@dimen/profile_stats_vertical_padding">

                    <LinearLayout
                        android:id="@+id/statPosts"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPostCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="@color/profile_text_primary"
                            android:textSize="@dimen/profile_stat_number_text_size"
                            android:textStyle="bold"
                            tools:text="128" />

                        <TextView
                            android:id="@+id/tvPostLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/profile_stat_label_gap"
                            android:maxLines="1"
                            android:text="@string/profile_stat_posts"
                            android:textColor="@color/profile_stat_label"
                            android:textSize="@dimen/profile_stat_label_text_size" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/statFollowing"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvFollowingCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="@color/profile_text_primary"
                            android:textSize="@dimen/profile_stat_number_text_size"
                            android:textStyle="bold"
                            tools:text="36" />

                        <TextView
                            android:id="@+id/tvFollowingLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/profile_stat_label_gap"
                            android:maxLines="1"
                            android:text="@string/profile_stat_following"
                            android:textColor="@color/profile_stat_label"
                            android:textSize="@dimen/profile_stat_label_text_size" />
                    </LinearLayout>

                    <View
                        android:id="@+id/statsVerticalDivider"
                        android:layout_width="@dimen/profile_stats_divider_width"
                        android:layout_height="@dimen/profile_stats_divider_height"
                        android:background="@color/profile_divider" />

                    <LinearLayout
                        android:id="@+id/statFollowers"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvFollowerCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="@color/profile_text_primary"
                            android:textSize="@dimen/profile_stat_number_text_size"
                            android:textStyle="bold"
                            tools:text="512" />

                        <TextView
                            android:id="@+id/tvFollowerLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/profile_stat_label_gap"
                            android:maxLines="1"
                            android:text="@string/profile_stat_followers"
                            android:textColor="@color/profile_stat_label"
                            android:textSize="@dimen/profile_stat_label_text_size" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/statLikes"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvLikeCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="@color/profile_text_primary"
                            android:textSize="@dimen/profile_stat_number_text_size"
                            android:textStyle="bold"
                            tools:text="1286" />

                        <TextView
                            android:id="@+id/tvLikeLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/profile_stat_label_gap"
                            android:maxLines="1"
                            android:text="@string/profile_stat_likes"
                            android:textColor="@color/profile_stat_label"
                            android:textSize="@dimen/profile_stat_label_text_size" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/profile_card_gap"
                app:cardBackgroundColor="@color/main_surface"
                app:cardCornerRadius="@dimen/profile_card_corner_radius"
                app:cardElevation="0dp"
                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/menuContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/rowMyPosts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:contentDescription="@string/profile_my_posts"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/profile_menu_row_min_height"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/profile_menu_horizontal_padding"
                        android:paddingEnd="@dimen/profile_menu_horizontal_padding">

                        <ImageView
                            android:layout_width="@dimen/profile_menu_icon_size"
                            android:layout_height="@dimen/profile_menu_icon_size"
                            android:importantForAccessibility="no"
                            android:src="@drawable/icon_my_post" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/profile_menu_icon_text_gap"
                            android:layout_weight="1"
                            android:importantForAccessibility="no"
                            android:text="@string/profile_my_posts"
                            android:textColor="@color/profile_text_primary"
                            android:textSize="@dimen/profile_menu_text_size" />

                        <ImageView
                            android:layout_width="@dimen/profile_chevron_size"
                            android:layout_height="@dimen/profile_chevron_size"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_profile_chevron_right" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/profile_menu_divider_height"
                        android:layout_marginStart="@dimen/profile_menu_divider_start"
                        android:background="@color/profile_divider" />

                    <LinearLayout
                        android:id="@+id/rowMyFavorites"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:contentDescription="@string/profile_my_favorites"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/profile_menu_row_min_height"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/profile_menu_horizontal_padding"
                        android:paddingEnd="@dimen/profile_menu_horizontal_padding">

                        <ImageView
                            android:layout_width="@dimen/profile_menu_icon_size"
                            android:layout_height="@dimen/profile_menu_icon_size"
                            android:importantForAccessibility="no"
                            android:src="@drawable/icon_my_favorite" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/profile_menu_icon_text_gap"
                            android:layout_weight="1"
                            android:importantForAccessibility="no"
                            android:text="@string/profile_my_favorites"
                            android:textColor="@color/profile_text_primary"
                            android:textSize="@dimen/profile_menu_text_size" />

                        <ImageView
                            android:layout_width="@dimen/profile_chevron_size"
                            android:layout_height="@dimen/profile_chevron_size"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_profile_chevron_right" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/profile_menu_divider_height"
                        android:layout_marginStart="@dimen/profile_menu_divider_start"
                        android:background="@color/profile_divider" />

                    <LinearLayout
                        android:id="@+id/rowBrowsingHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:contentDescription="@string/profile_browsing_history"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/profile_menu_row_min_height"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/profile_menu_horizontal_padding"
                        android:paddingEnd="@dimen/profile_menu_horizontal_padding">

                        <ImageView
                            android:layout_width="@dimen/profile_menu_icon_size"
                            android:layout_height="@dimen/profile_menu_icon_size"
                            android:importantForAccessibility="no"
                            android:src="@drawable/icon_browsing_history" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/profile_menu_icon_text_gap"
                            android:layout_weight="1"
                            android:importantForAccessibility="no"
                            android:text="@string/profile_browsing_history"
                            android:textColor="@color/profile_text_primary"
                            android:textSize="@dimen/profile_menu_text_size" />

                        <ImageView
                            android:layout_width="@dimen/profile_chevron_size"
                            android:layout_height="@dimen/profile_chevron_size"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_profile_chevron_right" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/profile_menu_divider_height"
                        android:layout_marginStart="@dimen/profile_menu_divider_start"
                        android:background="@color/profile_divider" />

                    <LinearLayout
                        android:id="@+id/rowMessageNotification"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:contentDescription="@string/profile_message_notification"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/profile_menu_row_min_height"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/profile_menu_horizontal_padding"
                        android:paddingEnd="@dimen/profile_menu_horizontal_padding">

                        <ImageView
                            android:layout_width="@dimen/profile_menu_icon_size"
                            android:layout_height="@dimen/profile_menu_icon_size"
                            android:importantForAccessibility="no"
                            android:src="@drawable/icon_notice" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/profile_menu_icon_text_gap"
                            android:layout_weight="1"
                            android:importantForAccessibility="no"
                            android:text="@string/profile_message_notification"
                            android:textColor="@color/profile_text_primary"
                            android:textSize="@dimen/profile_menu_text_size" />

                        <ImageView
                            android:layout_width="@dimen/profile_chevron_size"
                            android:layout_height="@dimen/profile_chevron_size"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_profile_chevron_right" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/profile_menu_divider_height"
                        android:layout_marginStart="@dimen/profile_menu_divider_start"
                        android:background="@color/profile_divider" />

                    <LinearLayout
                        android:id="@+id/rowAccountSecurity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:contentDescription="@string/profile_account_security"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/profile_menu_row_min_height"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/profile_menu_horizontal_padding"
                        android:paddingEnd="@dimen/profile_menu_horizontal_padding">

                        <ImageView
                            android:layout_width="@dimen/profile_menu_icon_size"
                            android:layout_height="@dimen/profile_menu_icon_size"
                            android:importantForAccessibility="no"
                            android:src="@drawable/icon_account_security" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/profile_menu_icon_text_gap"
                            android:layout_weight="1"
                            android:importantForAccessibility="no"
                            android:text="@string/profile_account_security"
                            android:textColor="@color/profile_text_primary"
                            android:textSize="@dimen/profile_menu_text_size" />

                        <ImageView
                            android:layout_width="@dimen/profile_chevron_size"
                            android:layout_height="@dimen/profile_chevron_size"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_profile_chevron_right" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/profile_menu_divider_height"
                        android:layout_marginStart="@dimen/profile_menu_divider_start"
                        android:background="@color/profile_divider" />

                    <LinearLayout
                        android:id="@+id/rowSettings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:contentDescription="@string/profile_settings"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/profile_menu_row_min_height"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/profile_menu_horizontal_padding"
                        android:paddingEnd="@dimen/profile_menu_horizontal_padding">

                        <ImageView
                            android:layout_width="@dimen/profile_menu_icon_size"
                            android:layout_height="@dimen/profile_menu_icon_size"
                            android:importantForAccessibility="no"
                            android:src="@drawable/icon_setting" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/profile_menu_icon_text_gap"
                            android:layout_weight="1"
                            android:importantForAccessibility="no"
                            android:text="@string/profile_settings"
                            android:textColor="@color/profile_text_primary"
                            android:textSize="@dimen/profile_menu_text_size" />

                        <ImageView
                            android:layout_width="@dimen/profile_chevron_size"
                            android:layout_height="@dimen/profile_chevron_size"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_profile_chevron_right" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/profile_card_gap"
                app:cardBackgroundColor="@color/main_surface"
                app:cardCornerRadius="@dimen/profile_card_corner_radius"
                app:cardElevation="0dp"
                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/profile_logout_min_height"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/profile_logout"
                    android:textColor="@color/profile_text_secondary"
                    android:textSize="@dimen/profile_logout_text_size" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
