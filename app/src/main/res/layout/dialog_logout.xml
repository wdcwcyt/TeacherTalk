<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_profile_dialog_rounded"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/profile_dialog_content_padding">

        <TextView
            android:id="@+id/tvLogoutTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/profile_logout_confirm_title"
            android:textColor="@color/profile_text_primary"
            android:textSize="@dimen/profile_dialog_title_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLogoutMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auth_field_gap"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/profile_cancel_note_line_spacing"
            android:text="@string/profile_logout_confirm_message"
            android:textColor="@color/profile_text_secondary"
            android:textSize="@dimen/profile_cancel_note_text_size" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/main_tab_divider_height"
        android:background="@color/main_divider"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnDismissLogout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/auth_field_min_height"
            android:paddingStart="@dimen/auth_code_action_horizontal_padding"
            android:paddingEnd="@dimen/auth_code_action_horizontal_padding"
            android:text="@string/profile_logout_cancel"
            android:textColor="@color/profile_text_secondary"
            android:textSize="@dimen/profile_menu_text_size" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/main_divider"
            />

        <TextView
            android:id="@+id/btnConfirmLogout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/auth_field_min_height"
            android:paddingStart="@dimen/auth_code_action_horizontal_padding"
            android:paddingEnd="@dimen/auth_code_action_horizontal_padding"
            android:text="@string/profile_logout_confirm"
            android:textColor="@color/profile_log_out"
            android:textSize="@dimen/profile_menu_text_size" />
    </LinearLayout>
</LinearLayout>
