<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_page_background"
    android:paddingStart="@dimen/main_placeholder_horizontal_padding"
    android:paddingEnd="@dimen/main_placeholder_horizontal_padding">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="@dimen/main_placeholder_icon_container_size"
            android:layout_height="@dimen/main_placeholder_icon_container_size"
            android:background="@drawable/bg_main_placeholder_icon"
            android:importantForAccessibility="no"
            android:padding="@dimen/main_placeholder_icon_padding"
            android:src="@drawable/icon_message"
            app:tint="@color/main_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/main_placeholder_title_top_gap"
            android:gravity="center"
            android:text="@string/main_message"
            android:textColor="@color/main_text_primary"
            android:textSize="@dimen/main_placeholder_title_text_size"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/main_placeholder_description_top_gap"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/main_placeholder_line_spacing"
            android:text="@string/main_placeholder_description"
            android:textColor="@color/main_text_secondary"
            android:textSize="@dimen/main_placeholder_description_text_size" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
