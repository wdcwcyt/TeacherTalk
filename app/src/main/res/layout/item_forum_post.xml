<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/forum_card_bottom_margin"
    app:cardBackgroundColor="@color/main_surface"
    app:cardCornerRadius="@dimen/forum_card_corner_radius"
    app:cardElevation="0dp"
    app:rippleColor="@color/main_placeholder_icon_background"
    app:strokeColor="@color/main_divider"
    app:strokeWidth="@dimen/forum_card_stroke_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/forum_card_content_padding">

        <LinearLayout
            android:id="@+id/layoutPostAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivPostAuthorAvatar"
                android:layout_width="@dimen/forum_post_author_avatar_size"
                android:layout_height="@dimen/forum_post_author_avatar_size"
                android:background="@drawable/bg_main_placeholder_icon"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/icon_user_avatar"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.TeacherTalk.Avatar" />

            <TextView
                android:id="@+id/tvPostAuthorName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/forum_post_author_gap"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/main_text_primary"
                android:textSize="@dimen/forum_post_author_name_text_size" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPostTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/forum_post_content_top_margin"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/main_text_primary"
            android:textSize="@dimen/forum_post_title_text_size"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvPostPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/forum_post_content_top_margin"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/main_text_secondary"
            android:textSize="@dimen/forum_post_preview_text_size"
            android:visibility="gone" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutThumbnails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/forum_post_thumbnail_top_margin"
            android:visibility="gone">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivPostThumbnail1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_post_img_content"
                android:clipToOutline="true"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toStartOf="@id/ivPostThumbnail2"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.TeacherTalk.PostImage" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivPostThumbnail2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/forum_post_thumbnail_gap"
                android:background="@drawable/bg_post_img_content"
                android:clipToOutline="true"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toStartOf="@id/ivPostThumbnail3"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@id/ivPostThumbnail1"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.TeacherTalk.PostImage" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivPostThumbnail3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/forum_post_thumbnail_gap"
                android:background="@drawable/bg_post_img_content"
                android:clipToOutline="true"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@id/ivPostThumbnail2"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.TeacherTalk.PostImage" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/forum_post_stats_top_margin"
            android:gravity="end"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/layoutPostComments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/forum_post_stat_icon_size"
                    android:layout_height="@dimen/forum_post_stat_icon_size"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_comment"
                    app:tint="@color/forum_detail_text_secondary" />

                <TextView
                    android:id="@+id/tvPostCommentCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/forum_post_stat_icon_text_gap"
                    android:importantForAccessibility="no"
                    android:textColor="@color/forum_detail_text_secondary"
                    android:textSize="@dimen/forum_post_stat_text_size" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutPostLikes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/forum_post_stat_item_gap"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivPostLikeIcon"
                    android:layout_width="@dimen/forum_post_stat_icon_size"
                    android:layout_height="@dimen/forum_post_stat_icon_size"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_like_outline"
                    app:tint="@color/forum_detail_text_secondary" />

                <TextView
                    android:id="@+id/tvPostLikeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/forum_post_stat_icon_text_gap"
                    android:importantForAccessibility="no"
                    android:textColor="@color/forum_detail_text_secondary"
                    android:textSize="@dimen/forum_post_stat_text_size" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
