<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/forum_card_bottom_margin"
    app:cardBackgroundColor="@color/main_surface"
    app:cardCornerRadius="@dimen/forum_card_corner_radius"
    app:cardElevation="0dp"
    app:strokeColor="@color/main_divider"
    app:strokeWidth="@dimen/forum_card_stroke_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/forum_card_content_padding">

        <TextView
            android:id="@+id/tvPostTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/main_text_primary"
            android:textSize="@dimen/forum_post_title_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPostPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/forum_post_preview_top_margin"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/main_text_secondary"
            android:textSize="@dimen/forum_post_preview_text_size" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
