<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/order_load_more_top_gap"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <View
        android:layout_width="0dp"
        android:layout_height="@dimen/order_card_stroke_width"
        android:layout_weight="1"
        android:background="@color/main_divider" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/order_load_more_horizontal_gap"
        android:layout_marginEnd="@dimen/order_load_more_horizontal_gap"
        android:text="@string/order_load_more"
        android:textColor="@color/order_text_tertiary"
        android:textSize="@dimen/order_load_more_text_size" />

    <View
        android:layout_width="0dp"
        android:layout_height="@dimen/order_card_stroke_width"
        android:layout_weight="1"
        android:background="@color/main_divider" />
</LinearLayout>
