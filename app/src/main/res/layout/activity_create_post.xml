<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_page_background">

    <View
        android:id="@+id/statusBarSpacer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/main_surface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/postHeader"
        android:layout_width="0dp"
        android:layout_height="@dimen/post_header_height"
        android:background="@color/main_surface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarSpacer">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/post_header_action_size"
            android:layout_height="@dimen/post_header_action_size"
            android:layout_marginStart="@dimen/post_header_side_margin"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/post_back"
            android:focusable="true"
            android:padding="@dimen/post_back_icon_padding"
            android:src="@drawable/icon_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvPageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/post_page_title"
            android:textColor="@color/main_text_primary"
            android:textSize="@dimen/post_page_title_text_size"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnPublish"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/btnPublish"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/post_header_action_size"
            android:layout_marginEnd="@dimen/post_header_side_margin"
            android:background="@drawable/bg_post_publish_button_light"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="@dimen/post_publish_min_width"
            android:paddingStart="@dimen/post_publish_horizontal_padding"
            android:paddingEnd="@dimen/post_publish_horizontal_padding"
            android:text="@string/post_publish"
            android:textColor="@color/main_text_primary"
            android:textSize="@dimen/post_publish_text_size"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/headerDivider"
        android:layout_width="0dp"
        android:layout_height="@dimen/main_tab_divider_height"
        android:background="@color/main_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/postHeader" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollEditor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerDivider"
        app:layout_constraintWidth_max="@dimen/post_editor_max_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/post_editor_horizontal_padding"
            android:paddingTop="@dimen/post_editor_top_padding"
            android:paddingEnd="@dimen/post_editor_horizontal_padding"
            android:paddingBottom="@dimen/post_editor_bottom_padding">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/main_surface"
                app:cardCornerRadius="@dimen/post_card_corner_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/main_divider"
                app:strokeWidth="@dimen/post_card_stroke_width">

                <EditText
                    android:id="@+id/etTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="@string/post_title_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textCapSentences"
                    android:maxLength="100"
                    android:maxLines="1"
                    android:minHeight="@dimen/post_title_field_min_height"
                    android:paddingStart="@dimen/post_field_horizontal_padding"
                    android:paddingEnd="@dimen/post_field_horizontal_padding"
                    android:singleLine="true"
                    android:textColor="@color/main_text_primary"
                    android:textColorHint="@color/main_text_secondary"
                    android:textSize="@dimen/post_title_text_size" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/post_card_gap"
                app:cardBackgroundColor="@color/main_surface"
                app:cardCornerRadius="@dimen/post_card_corner_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/main_divider"
                app:strokeWidth="@dimen/post_card_stroke_width">

                <com.zl.teachertalk.ui.forum.InertialEditText
                    android:id="@+id/etContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:gravity="start|top"
                    android:hint="@string/post_content_hint"
                    android:inputType="textCapSentences|textMultiLine"
                    android:isScrollContainer="true"
                    android:maxLength="5000"
                    android:maxHeight="@dimen/post_content_field_max_height"
                    android:minHeight="@dimen/post_content_field_min_height"
                    android:overScrollMode="ifContentScrolls"
                    android:padding="@dimen/post_field_horizontal_padding"
                    android:scrollbars="vertical"
                    android:textColor="@color/main_text_primary"
                    android:textColorHint="@color/main_text_secondary"
                    android:textSize="@dimen/post_content_text_size" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/post_card_gap"
                app:cardBackgroundColor="@color/main_surface"
                app:cardCornerRadius="@dimen/post_card_corner_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/main_divider"
                app:strokeWidth="@dimen/post_card_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/post_image_section_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/post_add_image"
                        android:textColor="@color/main_text_secondary"
                        android:textSize="@dimen/post_image_label_text_size" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/post_image_row_top_gap"
                        android:clipToPadding="false"
                        android:fillViewport="false"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:id="@+id/btnAddImage"
                                android:layout_width="@dimen/post_add_image_touch_size"
                                android:layout_height="@dimen/post_add_image_touch_size"
                                android:clickable="true"
                                android:contentDescription="@string/post_add_image"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackgroundBorderless">

                                <ImageView
                                    android:layout_width="@dimen/post_image_add_size"
                                    android:layout_height="@dimen/post_image_add_size"
                                    android:layout_gravity="center"
                                    android:background="@drawable/bg_post_img_add"
                                    android:importantForAccessibility="no"
                                    android:scaleType="centerInside" />
                            </FrameLayout>

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/ivPostImage1"
                                android:layout_width="@dimen/post_image_slot_size"
                                android:layout_height="@dimen/post_image_slot_size"
                                android:layout_marginStart="@dimen/post_image_slot_gap"
                                android:background="@drawable/bg_post_img_content"
                                android:clipToOutline="true"
                                android:importantForAccessibility="no"
                                android:scaleType="centerCrop"
                                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.TeacherTalk.PostImage" />

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/ivPostImage2"
                                android:layout_width="@dimen/post_image_slot_size"
                                android:layout_height="@dimen/post_image_slot_size"
                                android:layout_marginStart="@dimen/post_image_slot_gap"
                                android:background="@drawable/bg_post_img_content"
                                android:clipToOutline="true"
                                android:importantForAccessibility="no"
                                android:scaleType="centerCrop"
                                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.TeacherTalk.PostImage" />

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/ivPostImage3"
                                android:layout_width="@dimen/post_image_slot_size"
                                android:layout_height="@dimen/post_image_slot_size"
                                android:layout_marginStart="@dimen/post_image_slot_gap"
                                android:background="@drawable/bg_post_img_content"
                                android:clipToOutline="true"
                                android:importantForAccessibility="no"
                                android:scaleType="centerCrop"
                                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.TeacherTalk.PostImage" />

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/ivPostImage4"
                                android:layout_width="@dimen/post_image_slot_size"
                                android:layout_height="@dimen/post_image_slot_size"
                                android:layout_marginStart="@dimen/post_image_slot_gap"
                                android:background="@drawable/bg_post_img_content"
                                android:clipToOutline="true"
                                android:importantForAccessibility="no"
                                android:scaleType="centerCrop"
                                android:visibility="gone"
                                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.TeacherTalk.PostImage" />

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/ivPostImage5"
                                android:layout_width="@dimen/post_image_slot_size"
                                android:layout_height="@dimen/post_image_slot_size"
                                android:layout_marginStart="@dimen/post_image_slot_gap"
                                android:background="@drawable/bg_post_img_content"
                                android:clipToOutline="true"
                                android:importantForAccessibility="no"
                                android:scaleType="centerCrop"
                                android:visibility="gone"
                                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.TeacherTalk.PostImage" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
