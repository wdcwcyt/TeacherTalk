<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/forum_detail_comment_horizontal_padding"
        android:paddingTop="@dimen/forum_detail_comment_item_vertical_padding"
        android:paddingEnd="@dimen/forum_detail_comment_horizontal_padding"
        android:paddingBottom="@dimen/forum_detail_comment_item_vertical_padding">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivCommentAvatar"
            android:layout_width="@dimen/forum_detail_comment_avatar_size"
            android:layout_height="@dimen/forum_detail_comment_avatar_size"
            android:background="@drawable/bg_forum_detail_avatar"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/icon_user_avatar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.TeacherTalk.Avatar" />

        <TextView
            android:id="@+id/tvCommentAuthor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/forum_detail_comment_avatar_gap"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/forum_detail_text_primary"
            android:textSize="@dimen/forum_detail_comment_name_text_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivCommentAvatar"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="@string/forum_detail_sample_comment_author" />

        <TextView
            android:id="@+id/tvCommentContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/forum_detail_comment_name_content_gap"
            android:lineSpacingExtra="@dimen/forum_detail_comment_content_line_spacing"
            android:textColor="@color/forum_detail_text_secondary"
            android:textSize="@dimen/forum_detail_comment_content_text_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvCommentAuthor"
            app:layout_constraintTop_toBottomOf="@id/tvCommentAuthor"
            tools:text="@string/forum_detail_sample_comment_content" />

        <TextView
            android:id="@+id/tvCommentTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/forum_detail_comment_content_time_gap"
            android:textColor="@color/forum_detail_text_tertiary"
            android:textSize="@dimen/forum_detail_comment_time_text_size"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvCommentAuthor"
            app:layout_constraintTop_toBottomOf="@id/tvCommentContent"
            tools:text="@string/forum_detail_sample_comment_time" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
