<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_page_background"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvRoleTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/role_select_horizontal_margin"
        android:layout_marginTop="@dimen/role_select_title_top_margin"
        android:layout_marginEnd="@dimen/role_select_horizontal_margin"
        android:gravity="center"
        android:text="@string/role_select_title"
        android:textColor="@color/login_text_primary"
        android:textSize="@dimen/role_select_title_text_size"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/roleContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/role_select_bottom_padding">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/roleParent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:contentDescription="@string/role_parent"
            android:focusable="true"
            android:foreground="@android:color/transparent"
            android:padding="@dimen/role_select_item_padding">

            <ImageView
                android:id="@+id/ivRoleParent"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_parent"
                app:layout_constraintBottom_toTopOf="@id/tvRoleParent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintWidth_max="@dimen/role_select_icon_max_size" />

            <TextView
                android:id="@+id/tvRoleParent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/role_select_label_top_margin"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/role_parent"
                android:textColor="@color/login_text_primary"
                android:textSize="@dimen/role_select_label_text_size"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivRoleParent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/roleTeacher"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:contentDescription="@string/role_teacher"
            android:focusable="true"
            android:foreground="@android:color/transparent"
            android:padding="@dimen/role_select_item_padding">

            <ImageView
                android:id="@+id/ivRoleTeacher"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_teacher"
                app:layout_constraintBottom_toTopOf="@id/tvRoleTeacher"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintWidth_max="@dimen/role_select_icon_max_size" />

            <TextView
                android:id="@+id/tvRoleTeacher"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/role_select_label_top_margin"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/role_teacher"
                android:textColor="@color/login_text_primary"
                android:textSize="@dimen/role_select_label_text_size"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivRoleTeacher" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

</LinearLayout>
