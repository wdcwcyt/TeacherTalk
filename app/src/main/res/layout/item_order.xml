<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/order_card_gap"
    android:background="@drawable/bg_order_card"
    android:clickable="true"
    android:clipToOutline="true"
    android:focusable="true"
    android:orientation="horizontal"
    android:padding="@dimen/order_card_content_padding">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvOrderTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/main_text_primary"
            android:textSize="@dimen/order_card_title_text_size"
            android:textStyle="bold"
            tools:text="初二数学一对一辅导" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/order_card_section_top_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvOrderSubject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_order_tag_subject"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:maxWidth="@dimen/order_subject_tag_max_width"
                android:minHeight="@dimen/order_tag_min_height"
                android:paddingStart="@dimen/order_tag_horizontal_padding"
                android:paddingEnd="@dimen/order_tag_horizontal_padding"
                android:textColor="@color/white"
                android:textSize="@dimen/order_tag_text_size"
                android:textStyle="bold"
                tools:text="数学" />

            <TextView
                android:id="@+id/tvOrderGrade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/order_tag_gap"
                android:background="@drawable/bg_order_tag_grade"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:maxWidth="@dimen/order_grade_tag_max_width"
                android:minHeight="@dimen/order_tag_min_height"
                android:paddingStart="@dimen/order_tag_horizontal_padding"
                android:paddingEnd="@dimen/order_tag_horizontal_padding"
                android:textColor="@color/main_primary"
                android:textSize="@dimen/order_tag_text_size"
                tools:text="初二" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOrderDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/order_card_section_top_gap"
            android:ellipsize="end"
            android:lineSpacingExtra="@dimen/order_card_line_spacing"
            android:maxLines="2"
            android:textColor="@color/main_text_secondary"
            android:textSize="@dimen/order_card_body_text_size"
            tools:text="孩子基础一般，主要想补一下函数和几何。每周两次，周末下午优先。" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/order_info_top_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/order_info_icon_size"
                android:layout_height="@dimen/order_info_icon_size"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_order_location"
                app:tint="@color/main_text_secondary" />

            <TextView
                android:id="@+id/tvOrderLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/order_info_icon_gap"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/main_text_secondary"
                android:textSize="@dimen/order_meta_text_size"
                tools:text="学校附近 · 线下" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/order_meta_top_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvOrderPublisherAvatar"
                android:layout_width="@dimen/order_avatar_size"
                android:layout_height="@dimen/order_avatar_size"
                android:background="@drawable/bg_order_avatar"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textColor="@color/main_primary"
                android:textSize="@dimen/order_avatar_text_size"
                android:textStyle="bold"
                tools:text="周" />

            <TextView
                android:id="@+id/tvOrderPublisherName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/order_info_icon_gap"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/main_text_secondary"
                android:textSize="@dimen/order_meta_text_size"
                tools:text="周女士" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/order_meta_dot"
                android:textColor="@color/order_text_tertiary"
                android:textSize="@dimen/order_meta_text_size" />

            <TextView
                android:id="@+id/tvOrderTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/order_info_icon_gap"
                android:ellipsize="end"
                android:maxWidth="@dimen/order_meta_time_max_width"
                android:maxLines="1"
                android:textColor="@color/order_text_tertiary"
                android:textSize="@dimen/order_meta_text_size"
                tools:text="2 小时前" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="@dimen/order_card_stroke_width"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/order_card_main_price_gap"
        android:background="@color/main_divider" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:minWidth="@dimen/order_price_box_min_width"
        android:orientation="vertical"
        android:paddingStart="@dimen/order_price_horizontal_padding">

        <TextView
            android:id="@+id/tvOrderPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxWidth="@dimen/order_price_amount_max_width"
            android:singleLine="true"
            android:textColor="@color/main_primary"
            android:textSize="@dimen/order_price_amount_text_size"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="@dimen/order_price_amount_text_size"
            app:autoSizeMinTextSize="@dimen/order_price_amount_min_text_size"
            app:autoSizeStepGranularity="@dimen/order_price_amount_auto_size_step"
            app:autoSizeTextType="uniform"
            tools:text="¥120" />

        <TextView
            android:id="@+id/tvOrderPriceUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/order_price_unit_top_gap"
            android:singleLine="true"
            android:text="@string/order_price_unit"
            android:textColor="@color/order_text_tertiary"
            android:textSize="@dimen/order_price_unit_text_size" />
    </LinearLayout>
</LinearLayout>
