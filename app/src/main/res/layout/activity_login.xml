<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_page_background">

    <ImageView
        android:id="@+id/bg_img"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@mipmap/main_img_bg"
        android:scaleType="centerCrop"
        app:layout_constraintHeight_percent="0.3"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.24" />

    <LinearLayout
        android:id="@+id/layoutSessionCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guidelineHeader">

        <ProgressBar
            android:layout_width="@dimen/auth_session_check_progress_size"
            android:layout_height="@dimen/auth_session_check_progress_size"
            android:indeterminate="true"
            android:indeterminateTint="@color/login_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auth_session_check_text_top_gap"
            android:text="@string/auth_checking_session"
            android:textColor="@color/login_text_secondary"
            android:textSize="@dimen/auth_subtitle_text_size" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/scrollAuth"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guidelineHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="vertical"
            android:paddingStart="@dimen/auth_page_horizontal_margin"
            android:paddingTop="@dimen/auth_form_vertical_padding"
            android:paddingEnd="@dimen/auth_page_horizontal_margin"
            android:paddingBottom="@dimen/auth_form_vertical_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/login_teacher_talk"
                android:textColor="@color/login_text_primary"
                android:textSize="@dimen/auth_title_text_size"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_subtitle_top_gap"
                android:gravity="center"
                android:text="@string/auth_login_subtitle"
                android:textColor="@color/login_text_secondary"
                android:textSize="@dimen/auth_subtitle_text_size" />

            <EditText
                android:id="@+id/editPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_form_top_gap"
                android:background="@drawable/bg_login_input"
                android:hint="@string/auth_phone_hint"
                android:inputType="phone"
                android:maxLength="11"
                android:maxLines="1"
                android:minHeight="@dimen/auth_field_min_height"
                android:paddingStart="@dimen/auth_field_horizontal_padding"
                android:paddingEnd="@dimen/auth_field_horizontal_padding"
                android:singleLine="true"
                android:textColor="@color/login_text_primary"
                android:textColorHint="@color/login_text_hint"
                android:textSize="@dimen/auth_field_text_size" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_field_gap"
                android:background="@drawable/bg_login_input"
                android:gravity="center_vertical"
                android:minHeight="@dimen/auth_field_min_height"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/editVerificationCode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/auth_code_hint"
                    android:inputType="number"
                    android:maxLength="6"
                    android:maxLines="1"
                    android:minHeight="@dimen/auth_field_min_height"
                    android:paddingStart="@dimen/auth_field_horizontal_padding"
                    android:paddingEnd="@dimen/auth_field_inner_gap"
                    android:singleLine="true"
                    android:textColor="@color/login_text_primary"
                    android:textColorHint="@color/login_text_hint"
                    android:textSize="@dimen/auth_field_text_size" />

                <TextView
                    android:id="@+id/txtRequestCode"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/auth_field_min_height"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="@dimen/auth_code_action_min_width"
                    android:paddingStart="@dimen/auth_code_action_horizontal_padding"
                    android:paddingEnd="@dimen/auth_code_action_horizontal_padding"
                    android:text="@string/auth_request_code"
                    android:textColor="@color/login_primary"
                    android:textSize="@dimen/auth_code_action_text_size" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_action_top_gap"
                android:background="@drawable/bg_login_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="@dimen/auth_primary_button_min_height"
                android:paddingTop="@dimen/auth_primary_button_vertical_padding"
                android:paddingBottom="@dimen/auth_primary_button_vertical_padding"
                android:text="@string/auth_verify_and_login"
                android:textColor="@color/white"
                android:textSize="@dimen/login_button_text_size" />

            <TextView
                android:id="@+id/txtRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_link_top_gap"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="@dimen/login_link_min_height"
                android:paddingStart="@dimen/login_link_horizontal_padding"
                android:paddingEnd="@dimen/login_link_horizontal_padding"
                android:text="@string/registeranaccount"
                android:textColor="@color/login_primary"
                android:textSize="@dimen/login_link_text_size" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
