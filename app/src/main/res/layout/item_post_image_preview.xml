<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/ivPreviewImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />

    <ProgressBar
        android:id="@+id/progressPreview"
        android:layout_width="@dimen/post_image_preview_progress_size"
        android:layout_height="@dimen/post_image_preview_progress_size"
        android:layout_gravity="center"
        android:indeterminateTint="@color/white" />

    <TextView
        android:id="@+id/tvPreviewError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="@string/post_image_preview_failed"
        android:textColor="@color/white"
        android:textSize="@dimen/post_image_preview_error_text_size"
        android:visibility="gone" />

</FrameLayout>
