<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_profile_dialog_rounded">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/profile_dialog_content_padding">

        <TextView
            android:id="@+id/tvCancelAccountTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile_cancel_account_title"
            android:textColor="@color/profile_text_primary"
            android:textSize="@dimen/profile_dialog_title_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCancelAccountWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auth_field_gap"
            android:lineSpacingExtra="@dimen/profile_cancel_note_line_spacing"
            android:text="@string/profile_cancel_account_warning"
            android:textColor="@color/profile_text_secondary"
            android:textSize="@dimen/profile_cancel_note_text_size" />

        <TextView
            android:id="@+id/tvCancelAccountPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auth_field_gap"
            android:textColor="@color/profile_text_primary"
            android:textSize="@dimen/auth_code_action_text_size" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCancelAccountCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auth_field_gap"
            android:hint="@string/profile_cancel_code_hint"
            app:errorEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCancelAccountCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:digits="0123456789"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="6"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/btnRequestCancelAccountCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/auth_field_min_height"
            android:minWidth="@dimen/auth_code_action_min_width"
            android:paddingStart="@dimen/auth_code_action_horizontal_padding"
            android:paddingEnd="@dimen/auth_code_action_horizontal_padding"
            android:text="@string/profile_cancel_get_code"
            android:textColor="@color/main_primary"
            android:textSize="@dimen/auth_code_action_text_size" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auth_action_top_gap"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnDismissCancelAccount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="@dimen/auth_field_min_height"
                android:paddingStart="@dimen/auth_code_action_horizontal_padding"
                android:paddingEnd="@dimen/auth_code_action_horizontal_padding"
                android:text="@string/profile_logout_cancel"
                android:textColor="@color/profile_text_secondary"
                android:textSize="@dimen/profile_menu_text_size" />

            <TextView
                android:id="@+id/btnConfirmCancelAccount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="@dimen/auth_field_min_height"
                android:paddingStart="@dimen/auth_code_action_horizontal_padding"
                android:paddingEnd="@dimen/auth_code_action_horizontal_padding"
                android:text="@string/profile_cancel_account_confirm"
                android:textColor="@color/profile_log_out"
                android:textSize="@dimen/profile_menu_text_size" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
